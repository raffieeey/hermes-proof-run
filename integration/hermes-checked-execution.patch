+@pytest.fixture
+def ctx(manager):
+    _require_api()
+    return PluginContext(PluginManifest(name="adapter-owner", source="user"), manager)
+
+
+def _schema(name: str) -> dict:
+    return {
+        "name": name,
+        "description": "checked-execution probe",
+        "parameters": {"type": "object", "properties": {"n": {"type": "number"}}},
+    }
+
+
+def _register_owned(ctx: PluginContext, name: str, handler):
+    handle = ctx.register_tool(
+        name=name, toolset="checked_probe", schema=_schema(name), handler=handler,
+    )
+    assert handle is not None
+    return handle
+
+
+def _command_call(ctx, function, *, session_id="sess-1"):
+    """Positive checked calls go through a real registered command handler."""
+    global _CMD_N
+    _CMD_N += 1
+    name = f"zxce{_CMD_N}"
+
+    def handler(raw_args, **context):
+        return function(context)
+
+    handle = ctx.register_command(name, handler)
+    assert handle is not None
+    entry = ctx._manager._plugin_commands[name]
+    return invoke_plugin_command(
+        entry["handler"], "", source=None,
+        session_id=session_id, session_key=session_id, platform="cli",
+    )
+
+
+def _execute(ctx, name, args, **kwargs):
+    session_id = kwargs.pop("session_id", "sess-1")
+    run_id = kwargs.pop("run_id", "R-test")
+    extra = dict(kwargs)
+    return _command_call(
+        ctx,
+        lambda context: ctx.execute_checked(
+            name, args, session_id=context["session_id"], run_id=run_id, **extra,
+        ),
+        session_id=session_id,
+    )
+
