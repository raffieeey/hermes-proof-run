@@ -0,0 +1,101 @@
+"""Bound command/agent identity for checked execution.
+
+Public ``execute_checked`` signatures stay frozen. A nonempty ``session_id``
+argument is not authority. ``invoke_plugin_command`` and the live agent tool
+loop bind identity on a ContextVar that follows sync calls, asyncio tasks, and
+``contextvars.copy_context()`` executor threads. Missing or foreign identity
+fails closed with ``AUTH_CONTEXT_MISSING``.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from typing import Any, Iterator, Optional
+
+
+@dataclass(frozen=True)
+class BoundExecutionContext:
+    """Host-bound identity for one command handler or live agent tool call."""
+
+    kind: str  # "command" | "agent"
+    session_id: str
+    session_key: str = ""
+    platform: str = ""
+    profile_id: str = ""
+
+
+_BOUND: ContextVar[Optional[BoundExecutionContext]] = ContextVar(
+    "hermes_checked_execution_bound", default=None,
+)
+_BOUND_AGENT: ContextVar[Any] = ContextVar(
+    "hermes_checked_execution_bound_agent", default=None,
+)
+
+
+def current_bound_context() -> Optional[BoundExecutionContext]:
+    return _BOUND.get()
+
+
+def current_bound_agent() -> Any:
+    bound = _BOUND.get()
+    if bound is None or bound.kind != "agent":
+        return None
+    return _BOUND_AGENT.get()
+
+
+def bound_profile_id() -> str:
+    try:
+        from hermes_cli.profiles import get_active_profile_name
+        return str(get_active_profile_name() or "")
+    except Exception:
+        return ""
+
+
+@contextmanager
+def bind_command_context(
+    *,
+    session_id: str = "",
+    session_key: str = "",
+    platform: str = "",
+    profile_id: str = "",
+) -> Iterator[BoundExecutionContext]:
+    """Mark the current task as a real registered command invocation."""
+    ctx = BoundExecutionContext(
+        kind="command",
+        session_id=str(session_id or ""),
+        session_key=str(session_key or ""),
+        platform=str(platform or ""),
+        profile_id=str(profile_id or ""),
+    )
+    token = _BOUND.set(ctx)
+    agent_token = _BOUND_AGENT.set(None)
+    try:
+        yield ctx
+    finally:
+        _BOUND.reset(token)
+        _BOUND_AGENT.reset(agent_token)
+
+
+@contextmanager
+def bind_agent_context(
+    agent: Any,
+    *,
+    session_id: str = "",
+    profile_id: str = "",
+) -> Iterator[BoundExecutionContext]:
+    """Mark the current task as a live agent tool-loop invocation."""
+    sid = str(session_id or getattr(agent, "session_id", "") or "")
+    ctx = BoundExecutionContext(
+        kind="agent",
+        session_id=sid,
+        profile_id=str(profile_id or ""),
+    )
+    token = _BOUND.set(ctx)
+    agent_token = _BOUND_AGENT.set(agent)
+    try:
+        yield ctx
+    finally:
+        _BOUND.reset(token)
+        _BOUND_AGENT.reset(agent_token)
