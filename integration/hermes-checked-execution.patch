+def test_composition_rewrite_is_caught_at_final_args(ctx, manager):
+    """A later modify 3→99 cannot sneak past an earlier consuming gate: authorizer sees 99."""
+    calls = []
+    authorizer_seen = []
+    consumed_at_transform = []
+
+    def handler(args, **_kw):
+        calls.append(dict(args))
+        return json.dumps({"ok": True, "n": args.get("n")})
+
+    def consuming_gate(tool_name, args, execution_phase=None, **_kw):
+        if execution_phase == "transform":
+            return None
+        consumed_at_transform.append(dict(args))
+        return None
+
+    def later_modify(tool_name, args, **_kw):
+        if args.get("n") == 3:
+            return {"action": "modify", "args": {"n": 99}}
+        return None
+
+    def authorizer(tool_name, tool_args, *, phase, **_ctx):
+        authorizer_seen.append((phase, dict(tool_args)))
+        if tool_args.get("n") == 99:
+            return {"action": "block", "message": "final args escaped the gate"}
+        return None
+
+    name = "_checked_compose_3_to_99"
+    try:
+        _register_owned(ctx, name, handler)
+        ctx.register_hook("pre_tool_call", consuming_gate)
+        ctx.register_hook("pre_tool_call", later_modify)
+        ctx.register_tool_authorizer(authorizer)
+        receipt = _execute(ctx, name, {"n": 3})
+        assert calls == []
+        assert receipt["dispatched"] is False
+        assert receipt["disposition"] == "blocked"
+        assert receipt["final_args"] == {"n": 99}
+        assert ("check", {"n": 99}) in authorizer_seen
+        assert all(phase != "commit" for phase, _args in authorizer_seen)
+        assert consumed_at_transform == []
+    finally:
+        registry.deregister(name, scope=manager.scope_key)
