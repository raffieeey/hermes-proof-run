+    proposed_args: dict[str, Any],
+    final_args: dict[str, Any],
+    profile_id: str,
+    session_id: str,
+    call_id: str,
+    message: str,
+    error_code: str,
+    run_id: str = "",
+    operation_identity: str = "",
+    policy_ref: str = "",
+    manager: Any = None,
