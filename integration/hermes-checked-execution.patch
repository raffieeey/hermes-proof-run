+        if agent is None:
+            return None, AUTH_CONTEXT_MISSING
+        return {
+            "agent": agent,
+            "session_id": effective_session or str(getattr(agent, "session_id", "") or ""),
+            "profile_id": bound.profile_id or profile_id,
+            "plugin_id": plugin_id,
+        }, ""
+    if not plugin_id or not caller_owns_tool(ctx._manager, plugin_id, tool_name):
+        return None, AUTH_CONTEXT_MISSING
+    return {
+        "agent": None,
+        "session_id": effective_session,
+        "profile_id": bound.profile_id or profile_id,
+        "plugin_id": plugin_id,
