@@ -0,0 +1,649 @@
+"""Generic checked tool execution: final authorizers, receipts, execute_checked.
+
+This is host-owned infrastructure. Plugins register authorizers and receipt sinks
+through PluginContext; core never imports a specific plugin.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+import uuid
+from copy import deepcopy
+from dataclasses import dataclass, field
+from typing import Any, Callable, Optional
+
+CHECKED_EXECUTION_VERSION = "checked-execution/v1"
+RECEIPT_SCHEMA = "ExecutionReceipt.v1"
+AUTHORIZER_SLOT = "v1"
+SINK_SLOT = "v1"
+PHASE_CHECK = "check"
+PHASE_COMMIT = "commit"
+PHASE_BEFORE = "before_dispatch"
+PHASE_TERMINAL = "terminal"
+PHASE_TRANSFORM = "transform"
+AUTH_CONTEXT_MISSING = "AUTH_CONTEXT_MISSING"
+PLUGIN_HOST_REFUSAL = (
+    "checked execution authorizers, receipt sinks, and execute_checked cannot cross "
+    "the plugin-host process boundary in this release"
+)
+
+_receipt_seq = 0
+
+
+def checked_execution_capabilities() -> dict[str, Any]:
+    """Functionality discovery for checked-execution/v1 (not a consent capability)."""
+    return {
+        "version": CHECKED_EXECUTION_VERSION,
+        "final_authorization": True,
+        "mandatory_receipts": True,
+        "bound_context": True,
+        "plugin_host_supported": False,
+        "plugin_host_refusal": PLUGIN_HOST_REFUSAL,
+    }
+
+
+def _next_sequence() -> int:
+    global _receipt_seq
+    _receipt_seq += 1
+    return _receipt_seq
+
+
+def _copy_args(args: Any) -> dict[str, Any]:
+    if not isinstance(args, dict):
+        return {}
+    try:
+        return deepcopy(args)
+    except Exception:
+        return dict(args)
+
+
+def _copy_receipt(receipt: dict[str, Any]) -> dict[str, Any]:
+    try:
+        return deepcopy(receipt)
+    except Exception:
+        copied = dict(receipt)
+        copied["proposed_args"] = _copy_args(receipt.get("proposed_args"))
+        copied["final_args"] = _copy_args(receipt.get("final_args"))
+        return copied
+
+
+def _snapshot_context(context: dict[str, Any]) -> dict[str, Any]:
+    snap: dict[str, Any] = {}
+    for key, value in context.items():
+        if isinstance(value, (dict, list)):
+            try:
+                snap[key] = deepcopy(value)
+            except Exception:
+                snap[key] = list(value) if isinstance(value, list) else dict(value)
+        else:
+            snap[key] = value
+    return snap
+
+
+def _active_profile_id() -> str:
+    try:
+        from hermes_cli.profiles import get_active_profile_name
+        return str(get_active_profile_name() or "")
+    except Exception:
+        return ""
+
+
+def _bind_approval_reason(message: str, final_args: dict[str, Any]) -> str:
+    """Put the effective payload in the displayed approval reason."""
+    payload = json.dumps(final_args, ensure_ascii=False, sort_keys=True, default=str)
+    text = message or ""
+    if payload in text:
+        return text or payload
+    if text:
+        return f"{text}\nEffective arguments: {payload}"
+    return payload
+
+
+
+def build_receipt(
+    *,
+    phase: str,
+    call_id: str,
+    profile_id: str,
+    session_id: str,
+    run_id: str,
+    tool_name: str,
+    proposed_args: dict[str, Any],
+    final_args: dict[str, Any],
+    dispatched: bool,
+    disposition: str,
+    result: Any = "",
+    operation_identity: str = "",
+    policy_ref: str = "",
+    error_code: str = "",
+    error_message: str = "",
+    receipt_persisted: bool = False,
+    sequence: int = 0,
+) -> dict[str, Any]:
+    if not isinstance(result, str):
+        result = "" if result is None else json.dumps(result, ensure_ascii=False)
+    return {
+        "schema": RECEIPT_SCHEMA,
+        "phase": phase,
+        "call_id": call_id,
+        "profile_id": profile_id,
+        "session_id": session_id,
+        "run_id": run_id,
+        "tool_name": tool_name,
+        "proposed_args": _copy_args(proposed_args),
+        "final_args": _copy_args(final_args),
+        "dispatched": bool(dispatched),
+        "disposition": disposition,
+        "result": result,
+        "operation_identity": operation_identity,
+        "policy_ref": policy_ref,
+        "error_code": error_code or "",
+        "error_message": error_message or "",
+        "receipt_persisted": bool(receipt_persisted),
+        "sequence": sequence or _next_sequence(),
+        "ts_ns": time.time_ns(),
+    }
+
+
+def caller_owns_tool(manager: Any, plugin_id: str, tool_name: str) -> bool:
+    """True when *plugin_id* has an active host-ledger tool registration for *tool_name*."""
+    if not plugin_id or not tool_name:
+        return False
+    ledger = getattr(manager, "_ownership_ledger", {}) or {}
+    for rec in ledger.get(plugin_id, ()):
+        if getattr(rec, "active", False) and rec.kind == "tool" and rec.key == tool_name:
+            return True
+    return False
+
+
+def _iter_slot(manager: Any, attr: str, slot: str) -> list[Callable]:
+    mapping = getattr(manager, attr, None) or {}
+    return list(mapping.get(slot, ()))
+
+
+def _invoke_callback(manager: Any, kind: str, callback: Callable, payload: dict[str, Any]) -> Any:
+    from hermes_cli.plugins_dispatch import PluginDispatchMixin, _HOOK_SKIPPED
+
+    timeout = 0.0
+    with_timeout = getattr(manager, "_run_hook_callback_bounded", None)
+    if with_timeout is not None:
+        try:
+            from hermes_cli.plugins import _resolve_hook_callback_timeout
+            timeout = float(_resolve_hook_callback_timeout() or 0)
+        except Exception:
+            timeout = 0.0
+    if timeout and with_timeout is not None:
+        ret = with_timeout(kind, callback, payload, timeout)
+        if ret is _HOOK_SKIPPED:
+            raise TimeoutError(f"{kind} callback timed out")
+        return ret
+    return PluginDispatchMixin._invoke_hook_callback(callback, payload)
+
+
+def _block_message(result: Any) -> Optional[str]:
+    if not isinstance(result, dict):
+        return None
+    if result.get("action") != "block":
+        return None
+    message = result.get("message")
+    if isinstance(message, str) and message.strip():
+        return message.strip()
+    return "blocked by tool authorizer"
+
+
+@dataclass
+class _Gate:
+    blocked: bool = False
+    message: str = ""
+    error_code: str = ""
+    check_ok: bool = True
+
+
+def run_authorizers(
+    manager: Any, tool_name: str, final_args: dict[str, Any], *, phase: str, context: dict[str, Any],
+) -> _Gate:
+    """Run every registered authorizer at *phase*. Errors/timeouts fail closed. No modify."""
+    gate = _Gate()
+    for callback in _iter_slot(manager, "_tool_authorizers", AUTHORIZER_SLOT):
+        payload = {
+            "tool_name": tool_name,
+            "tool_args": _copy_args(final_args),
+            "phase": phase,
+            **_snapshot_context(context),
+        }
+        try:
+            result = _invoke_callback(manager, "tool_authorizer", callback, payload)
+        except Exception as exc:
+            gate.blocked = True
+            gate.check_ok = False
+            gate.error_code = "AUTHORIZER_ERROR"
+            gate.message = f"tool authorizer failed: {exc}"
+            return gate
+        message = _block_message(result)
+        if message:
+            gate.blocked = True
+            gate.check_ok = False
+            gate.error_code = "AUTHORIZER_BLOCKED"
+            gate.message = message
+            return gate
+    return gate
+
+
+def emit_receipts(manager: Any, receipt: dict[str, Any], *, phase: str) -> tuple[bool, str]:
+    """Call mandatory sinks. Return (ok, error_message). Each sink gets an isolated snapshot."""
+    for callback in _iter_slot(manager, "_execution_receipt_sinks", SINK_SLOT):
+        payload = {"receipt": _copy_receipt(receipt), "phase": phase}
+        try:
+            _invoke_callback(manager, "execution_receipt_sink", callback, payload)
+        except Exception as exc:
+            return False, str(exc)
+    return True, ""
+
+
+def _error_json(message: str, error_code: str = "") -> str:
+    body: dict[str, Any] = {"error": message}
+    if error_code:
+        body["error_code"] = error_code
+    return json.dumps(body, ensure_ascii=False)
+
+
+def _active_manager(explicit: Any = None) -> Any:
+    if explicit is not None:
+        return explicit
+    from hermes_cli.plugins import get_plugin_manager
+    return get_plugin_manager()
+
+
+def _receipt_context(
+    *,
+    tool_name: str,
+    proposed_args: dict[str, Any],
+    final_args: dict[str, Any],
+    profile_id: str,
+    session_id: str,
+    run_id: str,
+    call_id: str,
+    operation_identity: str,
+    policy_ref: str,
+) -> dict[str, Any]:
+    return {
+        "tool_name": tool_name,
+        "proposed_args": proposed_args,
+        "final_args": final_args,
+        "profile_id": profile_id,
+        "session_id": session_id,
+        "run_id": run_id,
+        "call_id": call_id,
+        "operation_identity": operation_identity,
+        "policy_ref": policy_ref,
+    }
+
+
+def _make_receipt(ctx: dict[str, Any], *, phase: str, dispatched: bool, disposition: str,
+                  result: str = "", error_code: str = "", error_message: str = "",
+                  receipt_persisted: bool = False) -> dict[str, Any]:
+    return build_receipt(
+        phase=phase, call_id=ctx["call_id"], profile_id=ctx["profile_id"],
+        session_id=ctx["session_id"], run_id=ctx["run_id"], tool_name=ctx["tool_name"],
+        proposed_args=ctx["proposed_args"], final_args=ctx["final_args"],
+        dispatched=dispatched, disposition=disposition, result=result,
+        operation_identity=ctx["operation_identity"], policy_ref=ctx["policy_ref"],
+        error_code=error_code, error_message=error_message, receipt_persisted=receipt_persisted,
+    )
+
+
+@dataclass
+class CheckedScope:
+    """Admit a final payload, then record terminal receipts after the handler."""
+
+    manager: Any
+    ctx: dict[str, Any]
+    blocked: bool = False
+    message: str = ""
+    error_code: str = ""
+    admitted: bool = False
+    result_receipt: dict[str, Any] = field(default_factory=dict)
+
+    def complete(self, result: Any) -> dict[str, Any]:
+        text = result if isinstance(result, str) else json.dumps(result, ensure_ascii=False)
+        receipt = _make_receipt(
+            self.ctx, phase=PHASE_TERMINAL, dispatched=True, disposition="completed", result=text,
+        )
+        ok, err = emit_receipts(self.manager, receipt, phase=PHASE_TERMINAL)
+        if not ok:
+            receipt = _make_receipt(
+                self.ctx, phase=PHASE_TERMINAL, dispatched=True, disposition="unknown",
+                result=text, error_code="SINK_ERROR", error_message=err,
+            )
+            emit_receipts(self.manager, receipt, phase=PHASE_TERMINAL)
+        self.result_receipt = _copy_receipt(receipt)
+        return self.result_receipt
+
+    def fail(self, exc: BaseException) -> dict[str, Any]:
+        text = _error_json(str(exc), "HANDLER_ERROR")
+        receipt = _make_receipt(
+            self.ctx, phase=PHASE_TERMINAL, dispatched=True, disposition="handler_error",
+            result=text, error_code="HANDLER_ERROR", error_message=str(exc),
+        )
+        ok, err = emit_receipts(self.manager, receipt, phase=PHASE_TERMINAL)
+        if not ok:
+            receipt = _make_receipt(
+                self.ctx, phase=PHASE_TERMINAL, dispatched=True, disposition="unknown",
+                result=text, error_code="SINK_ERROR", error_message=err,
+            )
+            emit_receipts(self.manager, receipt, phase=PHASE_TERMINAL)
+        self.result_receipt = _copy_receipt(receipt)
+        return self.result_receipt
+
+
+def admit_checked_dispatch(
+    *,
+    tool_name: str,
+    proposed_args: dict[str, Any],
+    final_args: dict[str, Any],
+    manager: Any = None,
+    agent: Any = None,
+    profile_id: str = "",
+    session_id: str = "",
+    run_id: str = "",
+    tool_call_id: str = "",
+    task_id: str = "",
+    turn_id: str = "",
+    conversation_id: str = "",
+    operation_identity: str = "",
+    policy_ref: str = "",
+    plugin_id: str = "",
+) -> CheckedScope:
+    """Pure check, before_dispatch sinks, then consuming commit. Does not call the handler."""
+    manager = _active_manager(manager)
+    call_id = tool_call_id or uuid.uuid4().hex
+    proposed_args = _copy_args(proposed_args)
+    final_args = _copy_args(final_args)
+    ctx = _receipt_context(
+        tool_name=tool_name, proposed_args=proposed_args, final_args=final_args,
+        profile_id=profile_id, session_id=session_id, run_id=run_id, call_id=call_id,
+        operation_identity=operation_identity, policy_ref=policy_ref,
+    )
+    scope = CheckedScope(manager=manager, ctx=ctx)
+    auth_ctx = {
+        "session_id": session_id, "run_id": run_id, "operation_identity": operation_identity,
+        "policy_ref": policy_ref, "profile_id": profile_id, "tool_call_id": call_id,
+        "task_id": task_id, "turn_id": turn_id, "conversation_id": conversation_id,
+        "plugin_id": plugin_id, "has_agent": agent is not None,
+    }
+    check = run_authorizers(manager, tool_name, final_args, phase=PHASE_CHECK, context=auth_ctx)
+    if check.blocked:
+        scope.blocked, scope.message, scope.error_code = True, check.message, check.error_code
+        scope.result_receipt = _terminal_block(manager, ctx, check.message, check.error_code)
+        return scope
+    prepared = _make_receipt(ctx, phase=PHASE_BEFORE, dispatched=False, disposition="prepared")
+    ok, err = emit_receipts(manager, prepared, phase=PHASE_BEFORE)
+    if not ok:
+        scope.blocked, scope.message, scope.error_code = True, err, "SINK_ERROR"
+        scope.result_receipt = _terminal_block(manager, ctx, err, "SINK_ERROR")
+        return scope
+    commit = run_authorizers(manager, tool_name, final_args, phase=PHASE_COMMIT, context=auth_ctx)
+    if commit.blocked:
+        scope.blocked, scope.message, scope.error_code = True, commit.message, commit.error_code
+        scope.result_receipt = _terminal_block(manager, ctx, commit.message, commit.error_code)
+        return scope
+    scope.admitted = True
+    return scope
+
+
+def _terminal_block(manager: Any, ctx: dict[str, Any], message: str, error_code: str) -> dict[str, Any]:
+    receipt = _make_receipt(
