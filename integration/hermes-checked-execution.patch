+            result = registry.dispatch(tool_name, _copy_args(final_args), scope=manager.scope_key)
+        except Exception as exc:
+            outcome["receipt"] = scope.fail(exc)
+            return outcome["receipt"]
+        outcome["receipt"] = scope.complete(result)
+        return result
+
+    from hermes_cli.middleware import run_tool_execution_middleware
