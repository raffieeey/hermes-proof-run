+def resolve_checked_authority(ctx: Any, tool_name: str, *, session_id: str) -> tuple[Optional[dict[str, Any]], str]:
+    """Bind identity from command/agent ContextVar. A nonempty session string is not authority."""
+    from hermes_cli.plugin_command_session import current_bound_agent, current_bound_context
+
+    bound = current_bound_context()
+    plugin_id = str(getattr(ctx, "plugin_id", "") or "")
+    profile_id = str(getattr(ctx, "profile_name", "") or "") or _active_profile_id()
+    if bound is None:
+        return None, AUTH_CONTEXT_MISSING
+    supplied = str(session_id or "")
+    if supplied and supplied != str(bound.session_id or ""):
+        return None, AUTH_CONTEXT_MISSING
+    effective_session = str(bound.session_id or supplied)
+    if bound.kind == "agent":
