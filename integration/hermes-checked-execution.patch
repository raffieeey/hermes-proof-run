+        if agent is not None:
+            guardrails = getattr(agent, "_tool_guardrails", None)
+            before = getattr(guardrails, "before_call", None)
+            if callable(before):
+                decision = before(tool_name, final_args)
+                if not getattr(decision, "allows_execution", True):
+                    message = getattr(decision, "message", None) or "Tool blocked by guardrail policy"
+                    receipt = _terminal_block(manager, _receipt_ctx(final_args), message, "GUARDRAIL_BLOCKED")
+                    outcome["receipt"] = receipt
+                    return receipt
+
+        scope = admit_checked_dispatch(
+            tool_name=tool_name, proposed_args=proposed, final_args=final_args, manager=manager,
+            agent=agent, profile_id=profile_id, session_id=session_id, run_id=run_id,
+            tool_call_id=call_id, task_id=task_id, turn_id=turn_id, conversation_id=conversation_id,
+            operation_identity=operation_identity, policy_ref=policy_ref, plugin_id=plugin_id,
+        )
+        if scope.blocked:
+            outcome["receipt"] = scope.result_receipt
+            return scope.result_receipt
