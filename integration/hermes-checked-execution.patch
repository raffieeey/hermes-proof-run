+
+        try:
+            from agent.tool_dispatch_helpers import _context_pruned_argument_paths
+            pruned = _context_pruned_argument_paths(tool_name, final_args)
+        except Exception:
+            pruned = []
+        if pruned:
+            receipt = _terminal_block(manager, _receipt_ctx(final_args), "pruned tool arguments", "PRUNED_ARGUMENTS")
+            outcome["receipt"] = receipt
+            return receipt
