+                message=_bind_approval_reason(pending_approve.message or "", final_args),
+                rule_key=pending_approve.rule_key,
+            )
+            approve_block = _resolve_block_from_details(
+                approve_details, tool_name, turn_id=turn_id, tool_call_id=call_id, session_id=session_id,
+            )
+            if approve_block:
+                receipt = _terminal_block(manager, _receipt_ctx(final_args), approve_block, "POLICY_BLOCKED")
