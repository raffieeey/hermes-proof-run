+
+    def handler(args, **_kw):
+        calls.append(dict(args))
+        return json.dumps({"ok": True, "n": args.get("n")})
+
+    def rewrite(tool_name, args, execution_phase=None, **_kw):
+        if args.get("n") == 3:
+            return {"action": "modify", "args": {"n": 99}}
