+from tools.registry import registry
+_CMD_N = 0
+
+
+_REQUIRED_CTX = (
+    "checked_execution_capabilities",
+    "register_tool_authorizer",
+    "register_execution_receipt_sink",
+    "execute_checked",
+)
+
+
+def _require_api() -> None:
+    missing = [name for name in _REQUIRED_CTX if not callable(getattr(PluginContext, name, None))]
+    if missing:
+        pytest.fail(f"missing PluginContext API: {missing}")
+
+
+@pytest.fixture
+def manager(monkeypatch):
+    from hermes_cli import plugins as plugins_mod
+
+    mgr = PluginManager()
+    monkeypatch.setattr(plugins_mod, "get_plugin_manager", lambda: mgr)
+    monkeypatch.setattr(plugins_mod, "_plugin_manager", mgr)
+    return mgr
